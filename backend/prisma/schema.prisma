// Edurus — Database Schema
// Designed for multi-university expansion from day one: every tenant-scoped
// model carries a universityId so the platform can onboard new universities
// without a schema rewrite.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  AGENT
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  ANY
}

enum RoomType {
  SELF_CONTAIN
  SHARED
  ONE_BEDROOM
  TWO_BEDROOM
  HOSTEL
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum SleepSchedule {
  EARLY_BIRD
  NIGHT_OWL
  FLEXIBLE
}

enum CleanlinessLevel {
  RELAXED
  MODERATE
  VERY_CLEAN
}

enum NoiseTolerance {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  BOOKING_UPDATE
  MESSAGE
  LISTING_STATUS
  ROOMMATE_MATCH
  ROOMMATE_MATCH_REQUEST
  ROOMMATE_MATCH_ACCEPTED
  ROOMMATE_MATCH_DECLINED
  SYSTEM
  PROPERTY_INQUIRY
  INSPECTION_CONFIRMED
  VERIFICATION_APPROVED
  PROPERTY_APPROVED
  SECURITY_ALERT
  ACCOUNT_WARNING
  REQUEST_CREATED
  REQUEST_RESPONSE
  REVIEW_SUBMITTED
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ConversationType {
  PROPERTY_CHAT
  ROOMMATE_CHAT
}

// ---------------------------------------------------------------------------
// Core identity
// ---------------------------------------------------------------------------

model University {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  city      String
  country   String   @default("Nigeria")
  createdAt DateTime @default(now())

  students   Student[]
  properties Property[]
  accommodationRequests AccommodationRequest[]

  @@map("universities")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  twoFactorEnabled Boolean @default(false)
  // Legal consent tracking
  acceptedTerms Boolean? @default(false)
  acceptedTermsVersion String?
  acceptedTermsAt DateTime?
  pushToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student  Student?
  agent Agent?
  admin    Admin?

  verificationRequests AgentVerification[]
  notifications     Notification[]
  sentMessages      Message[]        @relation("MessageSender")
  refreshTokens      RefreshToken[]
  preferences        UserPreference?

  @@index([role])
  @@map("users")
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inApp     Boolean  @default(true)
  email     Boolean  @default(true)
  push      Boolean @default(false)
  securityNotifEnabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Role profiles
// ---------------------------------------------------------------------------

model Student {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  phone        String?
  university   University @relation(fields: [universityId], references: [id])
  universityId String
  faculty      String?
  level        String?
  gender       Gender?  @default(ANY)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings        Booking[]
  favourites      Favourite[]
  roommateProfile RoommateProfile?
  reviews         Review[]
  conversationsAsPrimary   Conversation[] @relation("ConversationPrimaryStudent")
  conversationsAsSecondary Conversation[] @relation("ConversationSecondaryStudent")
  roommateMatchesAsStudentA RoommateMatch[] @relation("RoommateMatchStudentA")
  roommateMatchesAsStudentB RoommateMatch[] @relation("RoommateMatchStudentB")
  sentMatchRequests  RoommateMatchRequest[] @relation("SentMatchRequests")
  receivedMatchRequests RoommateMatchRequest[] @relation("ReceivedMatchRequests")
  savedMatchs        RoommateMatchFavourite[] @relation("SavedMatches")
  savedTarget        RoommateMatchFavourite[] @relation("SavedTarget")
  accommodationRequests AccommodationRequest[]

  @@index([universityId])
  @@map("students")
}

model Agent {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  phone        String
  businessName String?
  isVerified   Boolean  @default(false)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  properties Property[]
  conversations Conversation[] @relation("ConversationAgent")
  verificationRequests AgentVerification[]

  @@map("agents")
}

model AgentVerification {
  id                    String             @id @default(cuid())
  userId                String
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId               String?
  agent                 Agent?             @relation(fields: [agentId], references: [id], onDelete: SetNull)
  idDocumentUrl         String
  selfieUrl             String?
  proofOfOwnershipUrl   String?
  status                VerificationStatus @default(PENDING)
  adminNotes            String?
  createdAt             DateTime           @default(now())
  reviewedAt            DateTime?
  submitterConfirmation Boolean?

  @@index([userId])
  @@index([status])
  @@map("agent_verifications")
}

model Admin {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  createdAt DateTime @default(now())

  @@map("admins")
}

// ---------------------------------------------------------------------------
// Properties
// ---------------------------------------------------------------------------

model Property {
  id                String        @id @default(cuid())
  agentId        String
  agent          Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  universityId      String
  university        University    @relation(fields: [universityId], references: [id])

  title             String
  description       String
  price             Decimal       @db.Decimal(10, 2)
  location          String
  distanceFromCampusKm Decimal    @db.Decimal(5, 2)
  bedrooms          Int
  bathrooms         Int
  roomType          RoomType
  genderRestriction Gender        @default(ANY)
  isAvailable       Boolean       @default(true)
  status            ListingStatus @default(PENDING)
  rejectionReason   String?

  latitude          Decimal?  @db.Decimal(10, 8)
  longitude         Decimal?  @db.Decimal(11, 8)
  formattedAddress  String?
  placeId           String?
  locationVisibility String? @default("public") // "public" | "approximate" | "private"

  // Student decision-making fields
  estimatedMoveInCost Decimal?     @db.Decimal(12, 2)
  agentFee           Decimal?     @db.Decimal(10, 2)
  legalFee           Decimal?     @db.Decimal(10, 2)
  cautionFee         Decimal?     @db.Decimal(10, 2)
  serviceCharge      Decimal?     @db.Decimal(10, 2)
  electricityNote    String?
  waterNote          String?
  internetNote       String?
  securityNote       String?
  rulesNotes         String?
  furnished          Boolean?      @default(false)
  hasGenerator       Boolean?      @default(false)
  hasInverter        Boolean?      @default(false)
  hasSolar           Boolean?      @default(false)
  hasBorehole        Boolean?      @default(false)
  hasSecurity        Boolean?      @default(false)
  hasGate            Boolean?      @default(false)
  hasWifi            Boolean?      @default(false)
  allowsCooking      Boolean?      @default(true)
  allowsVisitors     Boolean?      @default(true)
  allowsGenerator    Boolean?      @default(true)
  allowsAppliances   Boolean?      @default(true)
  hasCurfew          Boolean?      @default(false)
  propertyCondition  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images     PropertyImage[]
  amenities  PropertyAmenity[]
  bookings   Booking[]
  favourites Favourite[]
  reviews    Review[]
  conversations Conversation[]

  @@index([universityId, status])
  @@index([agentId])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  publicId   String   // Cloudinary public_id, needed for deletion
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([propertyId])
  @@map("property_images")
}

model Amenity {
  id   String @id @default(cuid())
  name String @unique // e.g. "WiFi", "Water Supply", "Security", "Parking"

  properties PropertyAmenity[]

  @@map("amenities")
}

// Explicit join table (rather than an implicit m-n) so we can extend it
// later (e.g. per-property notes on an amenity) without a migration that
// breaks existing data.
model PropertyAmenity {
  propertyId String
  amenityId  String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@map("property_amenities")
}

// ---------------------------------------------------------------------------
// Bookings & reviews
// ---------------------------------------------------------------------------

model Booking {
  id         String        @id @default(cuid())
  studentId  String
  student    Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  status     BookingStatus @default(PENDING)
  moveInDate DateTime
  message    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([propertyId, status])
  @@index([studentId])
  @@map("bookings")
}

model Review {
  id              String    @id @default(cuid())
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rating          Int       // 1-5, validated at the application layer
  comment         String?
  isApproved      Boolean   @default(true)
  isFlagged       Boolean   @default(false)
  flaggedReason   String?
  helpfulCount    Int       @default(0)
  unhelpfulCount  Int       @default(0)
  agentResponse   String?
  agentRespondedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([studentId, propertyId])
  @@map("reviews")
}

model Favourite {
  studentId  String
  propertyId String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([studentId, propertyId])
  @@map("favourites")
}

// ---------------------------------------------------------------------------
// Roommate matching
// ---------------------------------------------------------------------------

model RoommateProfile {
  id               String           @id @default(cuid())
  studentId        String           @unique
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  budgetMin        Decimal          @db.Decimal(10, 2)
  budgetMax        Decimal          @db.Decimal(10, 2)
  genderPreference Gender           @default(ANY)
  sleepSchedule    SleepSchedule
  cleanliness      CleanlinessLevel
  isSmoker         Boolean          @default(false)
  noiseTolerance   NoiseTolerance
  bio              String?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("roommate_profiles")
}

model RoommateMatch {
  id          String   @id @default(cuid())
  studentAId  String
  studentA    Student  @relation("RoommateMatchStudentA", fields: [studentAId], references: [id], onDelete: Cascade)
  studentBId  String
  studentB    Student  @relation("RoommateMatchStudentB", fields: [studentBId], references: [id], onDelete: Cascade)
  score       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversation Conversation?

  @@unique([studentAId, studentBId])
  @@index([studentAId])
  @@index([studentBId])
  @@map("roommate_matches")
}

enum MatchRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model RoommateMatchRequest {
  id          String                @id @default(cuid())
  senderId    String
  sender      Student               @relation("SentMatchRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    Student               @relation("ReceivedMatchRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status      MatchRequestStatus    @default(PENDING)
  message     String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  respondedAt DateTime?

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId, status])
  @@map("roommate_match_requests")
}

model RoommateMatchFavourite {
  id        String   @id @default(cuid())
  studentId String
  targetId  String
  student   Student  @relation("SavedMatches", fields: [studentId], references: [id], onDelete: Cascade)
  target    Student  @relation("SavedTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([studentId])
  @@unique([studentId, targetId])
  @@map("roommate_match_favourites")
}

// ---------------------------------------------------------------------------
// Property-based conversations
// ---------------------------------------------------------------------------

model Conversation {
  id                String           @id @default(cuid())
  type              ConversationType @default(PROPERTY_CHAT)
  propertyId        String?
  property          Property?        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roommateMatchId   String?          @unique
  roommateMatch     RoommateMatch?   @relation(fields: [roommateMatchId], references: [id], onDelete: Cascade)
  primaryStudentId  String?
  primaryStudent    Student?         @relation("ConversationPrimaryStudent", fields: [primaryStudentId], references: [id], onDelete: Cascade)
  secondaryStudentId String?
  secondaryStudent  Student?         @relation("ConversationSecondaryStudent", fields: [secondaryStudentId], references: [id], onDelete: SetNull)
  lastMessageId     String?
  agentId        String?
  agent          Agent?        @relation("ConversationAgent", fields: [agentId], references: [id], onDelete: Cascade)
  lastMessageContent String?
  lastMessageType   MessageType?
  lastMessageAt     DateTime?
  lastMessageSenderId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  isArchived        Boolean          @default(false)

  messages          Message[]

  @@unique([propertyId, primaryStudentId, agentId])
  @@index([type, updatedAt])
  @@index([propertyId])
  @@index([primaryStudentId])
  @@index([secondaryStudentId])
  @@index([agentId])
  @@map("conversations")
}

model Message {
  id             String             @id @default(cuid())
  conversationId String
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User               @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  messageType    MessageType        @default(TEXT)
  isRead         Boolean            @default(false)
  readAt         DateTime?
  deliveredAt    DateTime?          @default(now())
  deletedAt      DateTime?
  deletedByUserId String?
  createdAt      DateTime            @default(now())

  attachments    MessageAttachment[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id         String   @id @default(cuid())
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url        String
  publicId   String?
  fileName   String?
  mimeType   String?
  fileSize   Int?
  type       AttachmentType @default(IMAGE)
  createdAt  DateTime @default(now())

  @@index([messageId])
  @@map("message_attachments")
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

enum AttachmentType {
  IMAGE
  PDF
}

enum RoomTypePreference {
  SELF_CONTAIN
  SHARED
  ONE_BEDROOM
  TWO_BEDROOM
  HOSTEL
  ANY
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  actionUrl String?
  isSecurity Boolean @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}



model AccommodationRequest {
  id                String           @id @default(cuid())
  studentId         String
  student           Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  universityId      String
  university        University       @relation(fields: [universityId], references: [id])

  preferredLocation String
  budgetMin         Decimal?         @db.Decimal(10, 2)
  budgetMax         Decimal?         @db.Decimal(10, 2)
  roomType          RoomTypePreference
  genderPreference   Gender           @default(ANY)
  moveInDate        DateTime?
  numberOfOccupants Int?             @default(1)
  roommateRequired  Boolean          @default(false)
  preferences       String?
  additionalNotes   String?

  status            RequestStatus    @default(OPEN)
  respondedAt       DateTime?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([studentId, status])
  @@index([universityId, status])
  @@map("accommodation_requests")
}


