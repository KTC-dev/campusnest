NODE_ENV=production
PORT=4000
TRUST_PROXY=1
APP_VERSION=1.0.0

DATABASE_URL=<set-in-railway-or-local-env>
JWT_ACCESS_SECRET=<set-a-strong-secret>
JWT_REFRESH_SECRET=<set-a-different-strong-secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=https://campusnest.app,https://www.campusnest.app,https://campusnest.pages.dev,https://*.pages.dev

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
