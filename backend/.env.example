NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://user:password@localhost:5432/campushaven?schema=public"

JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment provider keys are intentionally absent for MVP.
# The payment service layer mocks these until a provider is chosen.
